{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "auroraengine",
    "version-string": "0.1.0",
    "description": "Aurora real-time rendering engine",
    "builtin-baseline": "fba75d09065fcc76a25dcf386b1d00d33f5175af",
    "dependencies": [
        "glfw3",
        {
            "name": "glad",
            "features": ["gl-api-46"]
        },
        "glm",
        "spdlog",
        "assimp",
        {
            "name": "imgui",
            "features": ["docking-experimental", "glfw-binding", "opengl3-binding"]
        }
    ]
}
